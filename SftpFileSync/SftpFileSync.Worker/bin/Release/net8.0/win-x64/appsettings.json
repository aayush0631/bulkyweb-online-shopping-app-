{
  "Sftp": {
    "Host": "localhost",
    "Port": 2222,
    "Username": "testuser",
    "Password": "testpassword",
    "RemotePath": "/upload",
    "LocalPath": "C:\\Downloads\\Sftp"
  },

  "Schedule": {
    "Cron": "*/1 * * * *"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}