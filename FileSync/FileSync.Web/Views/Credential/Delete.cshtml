@model FileSync.Models.Models.Credential

@{
    ViewData["Title"] = "Delete Connection";
}

<form method="post">
    <div class="card shadow border-0 mt-4">

        <div class="card-header bg-danger bg-gradient py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="text-white"><i class="bi bi-trash"></i> Delete Connection</h2>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                Are you sure you want to delete this credential? This action cannot be undone.
            </div>

            <input asp-for="Id" hidden />

            <table class="table table-bordered">
                <tr>
                    <th>Connection Name</th>
                    <td>@Model.ConnectionName</td>
                </tr>
                <tr>
                    <th>Protocol</th>
                    <td>
                        @if (Model.Protocol == FileSync.Models.Models.ProtocolType.FTP)
                        {
                            <span class="badge bg-info">FTP</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">SMB</span>
                        }
                    </td>
                </tr>
                <tr>
                    <th>Server Name</th>
                    <td>@Model.ServerName</td>
                </tr>
                @if (Model.Protocol == FileSync.Models.Models.ProtocolType.FTP)
                {
                    <tr>
                        <th>Port</th>
                        <td>@(Model.Port > 0 ? Model.Port : 21)</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <th>Share Name</th>
                        <td>@Model.ShareName</td>
                    </tr>
                }
                <tr>
                    <th>Username</th>
                    <td>@Model.UserName</td>
                </tr>
            </table>

            <div class="row pt-2">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-danger form-control">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-action="Index" class="btn btn-outline-secondary form-control">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>

        </div>
    </div>
</form>
