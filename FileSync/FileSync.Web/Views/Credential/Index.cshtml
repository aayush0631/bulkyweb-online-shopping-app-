@model IEnumerable<FileSync.Models.ViewModels.CredentialViewModel>

@{
    ViewData["Title"] = "Credentials";
}

<div class="container p-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="bi bi-shield-lock"></i> Credentials
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Credential
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> No credentials configured yet. Click <strong>Add Credential</strong> to create one.
        </div>
    }
    else
    {
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Connection Name</th>
                    <th>Protocol</th>
                    <th>Server</th>
                    <th>Username</th>
                    <th class="text-center" style="width:180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ConnectionName</td>
                    <td>
                        @if (item.Protocol == FileSync.Models.Models.ProtocolType.FTP)
                        {
                            <span class="badge bg-info">FTP</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">SMB</span>
                        }
                    </td>
                    <td>
                        @if (item.Protocol == FileSync.Models.Models.ProtocolType.FTP)
                        {
                            @($"{item.ServerName}:{(item.Port > 0 ? item.Port : 21)}")
                        }
                        else
                        {
                            @($"\\\\{item.ServerName}\\{item.ShareName}")
                        }
                    </td>
                    <td>@item.UserName</td>

                    <td class="text-center">
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>