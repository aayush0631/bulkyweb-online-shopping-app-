@model FileSync.Models.ViewModels.CredentialViewModel

@{
    ViewData["Title"] = "Edit Connection";
}

<form method="post">
    <div class="card shadow border-0 mt-4">

        <div class="card-header bg-warning bg-gradient py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="text-white">Edit Connection</h2>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ConnectionName" class="form-label"></label>
                <input asp-for="ConnectionName"
                       class="form-control"
                       placeholder="My VPS, Office NAS, etc." />
                <span asp-validation-for="ConnectionName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Protocol" class="form-label"></label>
                <select asp-for="Protocol"
                        asp-items="Html.GetEnumSelectList<FileSync.Models.Models.ProtocolType>()"
                        class="form-select"
                        id="protocolSelect">
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="ServerName" class="form-label"></label>
                <input asp-for="ServerName"
                       class="form-control"
                       placeholder="192.168.1.100 or myserver.com" />
                <span asp-validation-for="ServerName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Port" class="form-label"></label>
                <input asp-for="Port"
                       type="number"
                       class="form-control"
                       placeholder="21 (FTP default) or 0 for SMB" />
            </div>

            <div class="mb-3" id="shareNameGroup">
                <label asp-for="ShareName" class="form-label"></label>
                <input asp-for="ShareName"
                       class="form-control"
                       placeholder="SharedFolder" />
                <span asp-validation-for="ShareName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName"
                       class="form-control"
                       autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="row pt-2">

                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-warning form-control">
                        <i class="bi bi-save"></i>
                        Save
                    </button>
                </div>

                <div class="col-6 col-md-3">
                    <a asp-action="Index" class="btn btn-outline-secondary form-control">
                        <i class="bi bi-arrow-left"></i>
                        Back
                    </a>
                </div>

            </div>

        </div>

    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var protocolSelect = document.getElementById('protocolSelect');
            var shareGroup = document.getElementById('shareNameGroup');
            var portInput = document.getElementById('Port');

            function toggle() {
                var isFtp = protocolSelect.value === '1';
                shareGroup.style.display = isFtp ? 'none' : '';
            }

            protocolSelect.addEventListener('change', toggle);
            toggle();
        })();
    </script>
}
