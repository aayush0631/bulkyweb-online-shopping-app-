@model FileSync.Models.Models.SyncTask

@{
    ViewData["Title"] = "Delete Sync Task";
}

<form method="post">
    <div class="card shadow border-0 mt-4">

        <div class="card-header bg-danger bg-gradient py-3">
            <div class="row">
                <div class="col-12 text-center">
                    <h2 class="text-white"><i class="bi bi-trash"></i> Delete Sync Task</h2>
                </div>
            </div>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                Are you sure you want to delete this sync task? This action cannot be undone.
            </div>

            <input asp-for="Id" hidden />

            <table class="table table-bordered">
                <tr>
                    <th>Task Name</th>
                    <td>@Model.TaskName</td>
                </tr>
                <tr>
                    <th>Connection</th>
                    <td>
                        @if (Model.Credential != null)
                        {
                            @($"{Model.Credential.ConnectionName} (\\\\{Model.Credential.ServerName}\\{Model.Credential.ShareName})")
                        }
                    </td>
                </tr>
                <tr>
                    <th>Remote Path</th>
                    <td><code>@Model.RemoteRelativePath</code></td>
                </tr>
                <tr>
                    <th>Local Path</th>
                    <td><code>@Model.LocalPath</code></td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>
                        @if (Model.IsEnabled)
                        {
                            <span class="badge bg-success">Enabled</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Disabled</span>
                        }
                    </td>
                </tr>
            </table>

            <div class="row pt-2">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-danger form-control">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
                <div class="col-6 col-md-3">
                    <a asp-action="Index" class="btn btn-outline-secondary form-control">
                        <i class="bi bi-arrow-left"></i> Back
                    </a>
                </div>
            </div>

        </div>
    </div>
</form>
