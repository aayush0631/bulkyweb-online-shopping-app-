@page
@model BulkyWebRazor_temp.Pages.Categories.DeleteModel

<form method="post">
    <input hidden asp-for="Category.Id" />
    <div class="border p-3 mt-4">
        <div class=" row pb-2">
            <h2 class=" text-primary">
                Delete Category
            </h2>
            <hr />
        </div>
        <div asp-validation-summary="All"></div>
        <div class="mb-3 row p-1">
            <label asp-for="Category.Name" class=" p-0"></label>
            <input asp-for="Category.Name" disabled class=" form-control" />
        </div>
        <div class="mb-3 row p-1">
            <label asp-for="Category.DisplayOrder" class=" p-0"></label>
            <input asp-for="Category.DisplayOrder" disabled class=" form-control" />
        </div>
        <button type="submit" class=" btn btn-danger" style="width:150px">
            delete
        </button>
        <a asp-page="/Categories/Index" class=" btn btn-secondary" style=" width: 150px">
            Back To List
        </a>

    </div>
</form>

// Loads the JavaScript libraries required for client-side validation.
// These scripts read the validation rules generated from the model
// and validate the form in the browser before it is submitted to the server.

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}